# Nach .env kopieren und ausfüllen. .env wird nie committet.
# Key anlegen unter https://openrouter.ai/settings/keys (dort ein Credit-Limit setzen)
OPENROUTER_API_KEY=
# Günstiges Modell für die Demo, Übersicht: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
APP_PASSWORD=
# Nur lokal: true schaltet die Passwortabfrage für die Entwicklung ab. Nie in den Cloud-Secrets setzen.
SKIP_LOGIN=false
# Nur lokal: true zeigt die interne Arbeits-Checkliste „Start“. Nie in den Cloud-Secrets setzen.
SHOW_INTERNAL_PAGES=false
